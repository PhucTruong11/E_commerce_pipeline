# Non-secret settings. Initialize-LocalEnv.ps1 creates root .env and separate secret files.
PGHOST=warehouse-laplaptech
PGPORT=5432
PGDATABASE=ecom_source_dev
PGSSLMODE=prefer
ECOM_SHARED_NETWORK=laplaptech-lab
ECOM_RUNTIME_MEMORY_MIB=1024
ECOM_RUNTIME_CPUS=1
INPUT_DIR=/input
BUILD_DIR=/state/build
RELEASE_DIR=/state/releases
ARTIFACT_DIR=/state/artifacts
DUCKDB_MEMORY_LIMIT=512MB
DBT_THREADS=1
DBT_SEND_ANONYMOUS_USAGE_STATS=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
